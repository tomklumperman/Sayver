{
  "expo": {
    "name": "Finances Overview",
    "slug": "finances-overview",
    "scheme": "sayver",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "truelayerClientId": "sandbox-sayverdevelopment-4b28b1",
      "truelayerEnv": "sandbox",
      "truelayerRedirectUri": "sayver://callback",
      "truelayerBackendBaseUrl": "http://192.168.1.61:3001",
      "eas": {
        "projectId": "6aae3443-879c-4f8b-bc6d-2292268cb3ba"
      }
    },
    "ios": {
      "bundleIdentifier": "com.tklumpermansteam.financesoverview",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f5132",
          "image": "./assets/icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0f5132",
            "image": "./assets/icon.png"
          }
        }
      ]
    ]
  }
}
